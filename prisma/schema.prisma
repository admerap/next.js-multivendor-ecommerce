generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  image         String?
  phone         String?    @db.VarChar(32)
  passwordHash  String
  role          Role       @default(CUSTOMER)
  /// Set by an admin (Customer List › Block): the account can't sign in, and an open session is ended on
  /// its next request. null = active. Past orders and reviews are kept as they are.
  blockedAt     DateTime?
  /// Staff only (role ADMIN): which admin-panel role this person has (Super Admin, admin, Sales…). null for
  /// customers and vendors.
  adminRoleId   String?
  adminRole     AdminRole? @relation(fields: [adminRoleId], references: [id])
  /// Soft delete (Users › Delete, staff only): hidden from lists, can't sign in, restorable. The email stays
  /// taken while the row exists.
  deletedAt     DateTime?
  /// Who deleted it (user id) — audit only.
  deletedById   String?    @db.VarChar(40)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  vendor          Vendor?
  accounts        Account[]
  sessions        Session[]
  orders          Order[]
  reviews         Review[]
  wishlist        WishlistItem[]
  /// Chat: this customer's conversations with stores.
  conversations   Conversation[]
  /// My Address: the customer's saved delivery addresses.
  addresses       Address[]
  /// Support Ticket: this customer's requests to Sundry support, and every message on them (customer or staff).
  supportTickets  SupportTicket[]
  supportMessages SupportTicketMessage[]
}

/// Support Ticket (supportticket design): a customer's request to Sundry support. `number` is the "#100241" the
/// customer quotes. Replies (theirs and staff's) are SupportTicketMessage rows; `description` is the opening one.
model SupportTicket {
  id          String                 @id @default(cuid())
  number      Int                    @unique
  userId      String
  subject     String                 @db.VarChar(150)
  type        SupportTicketType
  priority    SupportTicketPriority  @default(MEDIUM)
  status      SupportTicketStatus    @default(OPEN)
  description String                 @db.Text
  /// optional screenshot (PNG / JPG, up to 5 MB)
  attachment  String?                @db.VarChar(255)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportTicketMessage[]

  @@index([userId, createdAt])
  @@index([status])
}

/// A reply on a support ticket — from the customer, or from staff (`fromStaff`). The author may be removed later.
model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String?
  fromStaff Boolean       @default(false)
  body      String        @db.Text
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/// My Address (useraddress design): a customer's saved delivery address — the same fields and rules as a
/// checkout address (lib/validations/checkout), so any saved one can ship an order. One per customer is the
/// default (the first saved becomes it; deleting it promotes the next).
model Address {
  id        String      @id @default(cuid())
  userId    String
  type      AddressType @default(HOME)
  name      String      @db.VarChar(120)
  phone     String      @db.VarChar(32)
  country   String      @db.VarChar(60)
  /// state / province code ("NY", "ON") or a UK county
  state     String?     @db.VarChar(60)
  city      String      @db.VarChar(120)
  zip       String      @db.VarChar(16)
  address   String      @db.VarChar(500)
  /// apartment, suite, unit, floor… (optional)
  address2  String?     @db.VarChar(100)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A seller's store. Exactly one per VENDOR user.
model Vendor {
  id           String       @id @default(cuid())
  userId       String       @unique
  storeName    String
  slug         String       @unique
  phone        String
  storeAddress String       @db.VarChar(500)
  status       VendorStatus @default(PENDING)

  // Admin › Add New Vendor (adminaddvendor design). Optional so self-registered vendors stay valid.
  vendorImage    String?
  logo           String?
  coverImage     String?
  tinNumber      String?   @db.VarChar(40)
  tinExpiresAt   DateTime? @db.Date
  /// Private file (not under /public) — only admins should ever download it.
  tinCertificate String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  coupons       Coupon[]
  storeOrders   StoreOrder[]
  /// Chat: customers talking to this store.
  conversations Conversation[]
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

/// Product brand (admin-managed). slug is generated from name for storefront filtering.
model Brand {
  id        String      @id @default(cuid())
  name      String      @unique @db.VarChar(60)
  slug      String      @unique
  image     String?
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  products Product[]
}

// ── Auth.js adapter models (unused with JWT sessions, kept so the adapter is satisfied) ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

/// Catalog tree, level 1: Category → SubCategory → SubSubCategory.
model Category {
  id               String           @id @default(cuid())
  name             String           @unique @db.VarChar(60)
  slug             String           @unique
  image            String?
  status           CategoryStatus   @default(ACTIVE)
  subCategories    SubCategory[]
  subSubCategories SubSubCategory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  products Product[]
}

/// Level 2. Name is unique within its category.
model SubCategory {
  id               String           @id @default(cuid())
  name             String           @db.VarChar(60)
  slug             String           @unique
  status           CategoryStatus   @default(ACTIVE)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subSubCategories SubSubCategory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  products Product[]

  @@unique([categoryId, name])
}

/// Level 3. Name is unique within its sub-category; categoryId must match the sub-category's.
model SubSubCategory {
  id            String         @id @default(cuid())
  name          String         @db.VarChar(60)
  slug          String         @unique
  status        CategoryStatus @default(ACTIVE)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategoryId String
  subCategory   SubCategory    @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  products Product[]

  @@unique([subCategoryId, name])
  @@index([categoryId])
}

// ── Products (vendor catalog) ──
// Money is integer cents (CLAUDE.md §6): price 115900 = $1,159.00. Never Float.
// Two independent statuses: approvalStatus is the admin's review; isActive is the vendor's
// own show/hide switch. The storefront shows a product only when APPROVED and active.

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductUnit {
  PC
  KG
  G
  BOX
  PAIR
}

enum DiscountType {
  FLAT // discountValue in cents
  PERCENT // discountValue in whole percent (0–100)
}

model Product {
  id       String @id @default(cuid())
  vendorId String
  // Vendor delete (only via account delete) removes their catalog; order history will keep its
  // own snapshot of items, so it never depends on this row.
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name             String      @db.VarChar(200)
  slug             String      @unique @db.VarChar(220)
  sku              String      @db.VarChar(64)
  productType      ProductType @default(PHYSICAL)
  unit             ProductUnit @default(PC)
  shortDescription String?     @db.VarChar(500)
  description      String      @db.Text
  /// Search tags: string[]
  tags             Json?

  // Catalog links: Restrict, so deleting a category/brand can never wipe products by accident.
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategoryId    String?
  subCategory      SubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  subSubCategoryId String?
  subSubCategory   SubSubCategory? @relation(fields: [subSubCategoryId], references: [id], onDelete: Restrict)
  brandId          String?
  brand            Brand?          @relation(fields: [brandId], references: [id], onDelete: Restrict)

  // Pricing (cents)
  price           Int
  compareAtPrice  Int?
  discountType    DiscountType @default(FLAT)
  discountValue   Int          @default(0)
  /// Basis points: 825 = 8.25%
  taxRate         Int?
  shippingCost    Int          @default(0)
  shippingPerUnit Boolean      @default(false)

  // Stock: used only when the product has no variations (then each variation's stock counts).
  stock       Int @default(0)
  minOrderQty Int @default(1)

  thumbnail      String?
  videoUrl       String? @db.VarChar(255)
  /// Variation options the vendor entered, e.g. [{"name":"Color","values":["Red","Blue"]}].
  /// Kept so the edit form can rebuild the generator; the rows themselves live in ProductVariation.
  variantOptions Json?

  metaTitle       String? @db.VarChar(120)
  metaDescription String? @db.VarChar(320)

  approvalStatus  ProductApprovalStatus @default(PENDING)
  /// When it last entered PENDING (created, resubmitted after a deny, or re-review) — orders the admin queue.
  submittedAt     DateTime              @default(now())
  isActive        Boolean               @default(true)
  /// Admin's note to the vendor when the product is denied (REJECTED); cleared on approval.
  rejectionReason String?               @db.VarChar(500)

  // Admin merchandising flags. The storefront honours them only for APPROVED + active products.
  isFeatured Boolean @default(false)
  isPopular  Boolean @default(false)

  /// Average of APPROVED reviews in hundredths (450 = 4.50 stars) — an integer, never a float.
  /// Recomputed whenever a review is approved, rejected or deleted.
  ratingAvg   Int @default(0)
  /// Number of APPROVED reviews.
  reviewCount Int @default(0)

  images        ProductImage[]
  variations    ProductVariation[]
  couponLinks   CouponProduct[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistedBy  WishlistItem[]
  /// Chat threads started from this product's page (context only).
  conversations Conversation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([vendorId, sku])
  @@index([vendorId, approvalStatus])
  @@index([approvalStatus, isActive])
  @@index([approvalStatus, submittedAt])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([subSubCategoryId])
  @@index([brandId])
}

/// Gallery ("Product Additional Images"); the thumbnail lives on Product.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

/// One row per sold combination, e.g. "Red / M". Price and stock are per row.
model ProductVariation {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// "Red / M" — stable key for the combination within its product
  name       String   @db.VarChar(160)
  /// {"Color":"Red","Size":"M"}
  attributes Json
  sku        String?  @db.VarChar(64)
  price      Int
  stock      Int      @default(0)
  image      String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, name])
}

// ── Coupons (vendor promotions, vendorcoupon design) ──
// A vendor coupon only ever discounts that vendor's own items (enforced in lib/coupons).
// Money is integer cents (CLAUDE.md §6). Dates are calendar days, both inclusive.

enum CouponType {
  DISCOUNT // "Discount on Purchase"
  FREE_DELIVERY // waives this store's shipping
  FIRST_ORDER // discount valid on the customer's first order from this store
}

enum CouponDiscountType {
  AMOUNT // discountValue in cents
  PERCENTAGE // discountValue in whole percent (1–100)
}

enum CouponScope {
  STORE_WIDE
  SPECIFIC_PRODUCTS
}

enum CouponApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Coupon {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Unique per vendor (two stores can both have SAVE10); stored upper-case.
  code            String               @db.VarChar(32)
  title           String               @db.VarChar(100)
  type            CouponType           @default(DISCOUNT)
  discountType    CouponDiscountType   @default(AMOUNT)
  /// cents (AMOUNT) or whole percent (PERCENTAGE); 0 for FREE_DELIVERY
  discountValue   Int                  @default(0)
  scope           CouponScope          @default(STORE_WIDE)
  /// cents; checked against this vendor's subtotal only
  minPurchase     Int                  @default(0)
  /// cents; cap for PERCENTAGE coupons
  maxDiscount     Int?
  /// total redemptions allowed (null = unlimited)
  usageLimit      Int?
  /// redemptions per customer (null = unlimited)
  limitPerUser    Int?
  usedCount       Int                  @default(0)
  startsAt        DateTime             @db.Date
  expiresAt       DateTime             @db.Date
  isActive        Boolean              @default(true)
  /// Admin review: new vendor coupons start PENDING and only APPROVED ones apply at checkout.
  approvalStatus  CouponApprovalStatus @default(PENDING)
  /// When it last entered PENDING (created, resubmitted after a deny, or terms changed) — orders the admin queue.
  submittedAt     DateTime             @default(now())
  /// Admin's note to the vendor when the coupon is denied (REJECTED); cleared on approval.
  rejectionReason String?              @db.VarChar(500)

  products    CouponProduct[]
  storeOrders StoreOrder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([vendorId, code])
  @@index([vendorId, isActive])
  @@index([approvalStatus, submittedAt])
}

/// Products a SPECIFIC_PRODUCTS coupon applies to (always the coupon vendor's own products).
model CouponProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

// ── Orders (checkout) ──
// One checkout = one parent Order (customer, addresses, payment, grand totals) split into one StoreOrder
// per seller (its items, its own totals and fulfilment status — what that vendor sees) → OrderItems.
// Money is integer cents. Items, prices and addresses are SNAPSHOTS, so history survives later edits
// or deletions of products, variations and coupons.

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKAGING
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

/// COD in v1; STRIPE is the seam for the card / wallet integration that follows.
enum PaymentMethod {
  COD
  STRIPE
}

/// Delivery speed chosen once for the whole order (every store ships with it).
enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum SupportTicketType {
  WEBSITE
  ORDER
  PAYMENT
  SELLER
  ACCOUNT
}

enum SupportTicketPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

/// Open (new) · Pending (waiting on the customer) · Answered (staff replied) · Resolved · Closed
enum SupportTicketStatus {
  OPEN
  PENDING
  ANSWERED
  RESOLVED
  CLOSED
}

model Order {
  id          String @id @default(cuid())
  /// Human-facing number shown to customers ("#100196"); allocated at placement, unique.
  orderNumber Int    @unique
  customerId  String
  /// Restrict: an account with orders can't be deleted out from under its order history.
  customer    User   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(UNPAID)
  /// Stripe seam (unused for COD).
  stripePaymentIntentId String?       @unique @db.VarChar(255)

  shippingMethod ShippingMethod @default(STANDARD)

  /// Sales tax used for this order (snapshot): the ship-to region and its rate in thousandths of a
  /// percent (6350 = 6.35%, 6875 = 6.875%). 0 / null when the destination has no configured rate.
  taxRate   Int     @default(0)
  taxRegion String? @db.VarChar(8)

  // Shipping address snapshot
  shipName        String      @db.VarChar(120)
  shipPhone       String      @db.VarChar(32)
  shipEmail       String      @db.VarChar(191)
  shipAddressType AddressType @default(HOME)
  shipCountry     String      @db.VarChar(60)
  /// State / province (code for US + Canada, free text county for the UK); optional for older rows.
  shipState       String?     @db.VarChar(60)
  shipCity        String      @db.VarChar(120)
  shipZip         String      @db.VarChar(20)
  shipAddress     String      @db.VarChar(500)
  /// Apt, suite, unit… (address line 2)
  shipAddress2    String?     @db.VarChar(100)

  /// When true the bill* fields are null and billing = shipping.
  billingSameAsShipping Boolean      @default(true)
  billName              String?      @db.VarChar(120)
  billPhone             String?      @db.VarChar(32)
  billEmail             String?      @db.VarChar(191)
  billAddressType       AddressType?
  billCountry           String?      @db.VarChar(60)
  billState             String?      @db.VarChar(60)
  billCity              String?      @db.VarChar(120)
  billZip               String?      @db.VarChar(20)
  billAddress           String?      @db.VarChar(500)
  billAddress2          String?      @db.VarChar(100)

  note String? @db.VarChar(500)

  // Grand totals (cents) = sums of the StoreOrders
  subtotal Int
  discount Int @default(0)
  shipping Int @default(0)
  tax      Int @default(0)
  total    Int

  /// Customer's "Hide from my orders" (their list only). The order itself is never deleted and stays
  /// visible to sellers, admins and reports.
  hiddenByCustomerAt DateTime?

  storeOrders StoreOrder[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([customerId, createdAt])
}

/// One step in a StoreOrder's history: the status it moved to, when, and who moved it
/// (actorRole null = the system). Append-only; StoreOrder.status stays the current value.
model StoreOrderStatusEvent {
  id           String      @id @default(cuid())
  storeOrderId String
  storeOrder   StoreOrder  @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  status       OrderStatus
  actorRole    Role?
  /// User id of whoever made the change (no FK: the record outlives the account).
  actorId      String?     @db.VarChar(40)
  createdAt    DateTime    @default(now())

  @@index([storeOrderId, createdAt])
}

/// One seller's part of an Order: its items, totals, coupon and fulfilment status (vendor-scoped).
model StoreOrder {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId String
  /// Restrict: a store with orders can't be deleted out from under them.
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  status        OrderStatus             @default(PENDING)
  /// This part's own payment: with COD each seller's part is delivered — and paid — separately.
  /// Order.paymentStatus is the roll-up (PAID once every live part is paid).
  paymentStatus PaymentStatus           @default(UNPAID)
  paidAt        DateTime?
  /// Every status this part went through, with when and who (tracking timeline + audit).
  events        StoreOrderStatusEvent[]

  // Cents
  subtotal       Int
  discount       Int @default(0)
  shipping       Int @default(0)
  tax            Int @default(0)
  total          Int
  /// Basis points snapshot (1000 = 10%) and the resulting commission on the item subtotal after discount.
  commissionRate Int @default(1000)
  commission     Int @default(0)

  /// Vendor coupon applied to this store's lines (SetNull keeps the order if the coupon is deleted).
  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String? @db.VarChar(40)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
  @@index([couponId])
}

/// A purchased line — name, variation, image and prices are snapshots taken at placement.
model OrderItem {
  id           String     @id @default(cuid())
  storeOrderId String
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)

  // Live links (SetNull: the line survives if the product / variation is later deleted)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  productName   String  @db.VarChar(200)
  productSlug   String? @db.VarChar(220)
  sku           String? @db.VarChar(64)
  variationName String? @db.VarChar(160)
  image         String?

  /// Unit price paid before the coupon (after the product's own discount), cents.
  unitPrice Int
  qty       Int
  /// This line's share of the store coupon discount, cents.
  discount  Int @default(0)
  tax       Int @default(0)
  /// unitPrice × qty − discount + tax
  lineTotal Int

  review Review?

  @@index([storeOrderId])
  @@index([productId])
  @@index([variationId])
}

// ── Reviews ──────────────────────────────────────────────────────────────────────────────────────

/// Admin moderation of customer reviews. REJECTED is labelled "Denied" in the UI.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A verified-buyer review: tied to the OrderItem that proves the purchase (one review per line).
/// New reviews start PENDING; the storefront shows APPROVED ones only.
model Review {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The purchased line this review is for — unique, so the same purchase can't be reviewed twice.
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// 1–5 stars (validated by Zod on the server).
  rating  Int
  title   String? @db.VarChar(120)
  comment String  @db.Text
  /// Optional photos: an array of /uploads/reviews/… paths.
  images  Json?

  status      ReviewStatus @default(PENDING)
  /// Admin show/hide of an APPROVED review (active / inactive), separate from the moderation decision.
  /// The storefront shows a review only when status = APPROVED AND isVisible.
  isVisible   Boolean      @default(true)
  /// When an admin approved or rejected it.
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([customerId])
  @@index([status, createdAt])
}

// ── Sales tax ────────────────────────────────────────────────────────────────────────────────────

/// Sales tax by ship-to region (US: state + DC), edited by admins. Checkout applies the destination's
/// rate to the items (after coupons); shipping isn't taxed. A region with no active row pays no tax.
model TaxRate {
  id        String   @id @default(cuid())
  /// Same value as the checkout address country ("United States").
  country   String   @db.VarChar(60)
  /// State / province code ("CT").
  region    String   @db.VarChar(8)
  /// Thousandths of a percent — an exact integer even for 3-decimal rates: 6350 = 6.35%, 6875 = 6.875%.
  rate      Int
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([country, region])
}

// ── Wishlist ─────────────────────────────────────────────────────────────────────────────────────

/// A product a customer saved (account › Wish List). A guest's browser list is merged in on sign-in.
model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  /// The same product can't be saved twice by one customer.
  @@unique([customerId, productId])
  @@index([productId])
}

// ── Chat: customer ↔ store (FR-A10 / FR-V13) ──────────────────────────────────

/// Who wrote a message: the customer, or the store (any of its staff — today, the vendor owner).
enum ChatSide {
  CUSTOMER
  VENDOR
}

/// One conversation per customer and store: "Chat with Vendor" for the same pair reopens it.
model Conversation {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// The product page it was started from (context only; the thread survives the product).
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Bumped on every message: both inboxes list newest activity first.
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@unique([customerId, vendorId])
  @@index([customerId, lastMessageAt])
  @@index([vendorId, lastMessageAt])
}

/// A chat message: text and/or one image. readAt is set when the other side opens the thread (unread counts).
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     ChatSide
  /// The user who wrote it (customer, or the store's user) — audit only; senderRole decides the side.
  senderId       String?      @db.VarChar(40)
  text           String?      @db.Text
  /// Public path under /uploads/chat/.
  image          String?      @db.VarChar(255)
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, senderRole, readAt])
}

// ── Admin staff roles (Users › Roles) ─────────────────────────────────────────

/// A role for the people who run the admin panel (Super Admin, Support, Accounting…). What each one can access
/// comes next (permissions). System roles — the Super Admin — can't be deleted or switched off.
model AdminRole {
  id          String                @id @default(cuid())
  name        String                @unique @db.VarChar(60)
  description String                @db.VarChar(255)
  isActive    Boolean               @default(true)
  isSystem    Boolean               @default(false)
  /// Soft delete: a deleted role is hidden everywhere (lists, selectors) but kept, and can be restored.
  deletedAt   DateTime?
  /// Who deleted it (user id) — audit only.
  deletedById String?               @db.VarChar(40)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  users       User[]
  permissions AdminRolePermission[]
}

/// Activity Log (Users › Activity Log): who did what to staff users and roles, and when. Rows are never edited
/// or deleted by the app. The actor and the item are snapshotted (name / label) so the log still reads right after
/// either changes or is deleted. `details` holds what changed — never a password (only that it changed).
model AuditLog {
  id          String   @id @default(cuid())
  /// user id of whoever did it (no FK: the log outlives the account)
  actorId     String?  @db.VarChar(40)
  actorName   String   @db.VarChar(120)
  actorEmail  String   @db.VarChar(191)
  /// e.g. "user.create", "user.update", "role.delete", "role.permissions"
  action      String   @db.VarChar(40)
  /// "user" | "role"
  entityType  String   @db.VarChar(20)
  entityId    String   @db.VarChar(40)
  entityLabel String   @db.VarChar(191)
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

/// What a role may do in one admin module (Roles › Permissions): Read · Create · Update · Delete. No row = no
/// access. The Super Admin (system role) always has everything and keeps no rows. Modules: lib/permissions.ts.
model AdminRolePermission {
  id        String    @id @default(cuid())
  roleId    String
  module    String    @db.VarChar(40)
  canRead   Boolean   @default(false)
  canCreate Boolean   @default(false)
  canUpdate Boolean   @default(false)
  canDelete Boolean   @default(false)
  updatedAt DateTime  @updatedAt
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}
