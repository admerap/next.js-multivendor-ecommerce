generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @db.VarChar(32)
  passwordHash  String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor   Vendor?
  accounts Account[]
  sessions Session[]
}

/// A seller's store. Exactly one per VENDOR user.
model Vendor {
  id           String       @id @default(cuid())
  userId       String       @unique
  storeName    String
  slug         String       @unique
  phone        String
  storeAddress String       @db.VarChar(500)
  status       VendorStatus @default(PENDING)

  // Admin › Add New Vendor (adminaddvendor design). Optional so self-registered vendors stay valid.
  vendorImage    String?
  logo           String?
  coverImage     String?
  tinNumber      String?   @db.VarChar(40)
  tinExpiresAt   DateTime? @db.Date
  /// Private file (not under /public) — only admins should ever download it.
  tinCertificate String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

/// Product brand (admin-managed). slug is generated from name for storefront filtering.
model Brand {
  id        String      @id @default(cuid())
  name      String      @unique @db.VarChar(60)
  slug      String      @unique
  image     String?
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // TODO(catalog): add `products Product[]` once the Product model exists
  // (Product gets `brandId String?` + `brand Brand? @relation(fields: [brandId], references: [id])`).
}

// ── Auth.js adapter models (unused with JWT sessions, kept so the adapter is satisfied) ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

/// Catalog tree, level 1: Category → SubCategory → SubSubCategory.
model Category {
  id               String           @id @default(cuid())
  name             String           @unique @db.VarChar(60)
  slug             String           @unique
  image            String?
  status           CategoryStatus   @default(ACTIVE)
  subCategories    SubCategory[]
  subSubCategories SubSubCategory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // TODO(catalog): add `products Product[]` once the Product model exists, so product counts
  // come from `_count` (computed, never stored).
}

/// Level 2. Name is unique within its category.
model SubCategory {
  id               String           @id @default(cuid())
  name             String           @db.VarChar(60)
  slug             String           @unique
  status           CategoryStatus   @default(ACTIVE)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subSubCategories SubSubCategory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // TODO(catalog): add `products Product[]` once the Product model exists.

  @@unique([categoryId, name])
}

/// Level 3. Name is unique within its sub-category; categoryId must match the sub-category's.
model SubSubCategory {
  id            String         @id @default(cuid())
  name          String         @db.VarChar(60)
  slug          String         @unique
  status        CategoryStatus @default(ACTIVE)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategoryId String
  subCategory   SubCategory    @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // TODO(catalog): add `products Product[]` once the Product model exists.

  @@unique([subCategoryId, name])
  @@index([categoryId])
}
