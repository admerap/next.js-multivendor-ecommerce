{"SEG":"        <div class=\"vd-tools\" style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap\">\n          <span style=\"font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted)\">Preview state</span>\n          <div class=\"vd-seg\" style=\"display:flex;gap:2px;padding:4px;border-radius:var(--radius-md);background:var(--surface-sunken);border:1px solid var(--border-subtle)\"><sc-for list=\"{{ pTabs }}\" as=\"t\" hint-placeholder-count=\"4\"><button onClick=\"{{ t.onClick }}\" style=\"{{ t.style }}\">{{ t.label }}</button></sc-for></div>\n        </div>","TOAST":"      <sc-if value=\"{{ toastOn }}\" hint-placeholder-val=\"{{ false }}\">\n        <div role=\"status\" class=\"av-toast\" style=\"position:fixed;right:24px;bottom:24px;z-index:70;display:flex;align-items:center;gap:12px;max-width:min(420px,calc(100vw - 32px));padding:14px 18px;border-radius:var(--radius-lg);background:var(--surface-inverse);color:var(--text-inverse,#fff);box-shadow:var(--shadow-xl);font-size:14px;font-weight:600;animation:vdMore var(--dur-med) var(--ease-out)\"><span style=\"width:28px;height:28px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:{{ toastBg }}\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"{{ toastIcon }}\"/></svg></span>{{ toastMsg }}</div>\n      </sc-if>\n"}